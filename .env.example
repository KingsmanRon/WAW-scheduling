# ACCESS configuration: variable NAMES only. Values come from the platform's
# secret/variable store (Railway, Vercel, Supabase) or, for local work, from
# docker-compose.yml. Never commit values. Every runtime validates its
# configuration at startup and exits (code 78) naming what is wrong.
# Meaning, allowed values and per-profile rules: DEPLOYMENT.md.

# --- All runtimes -----------------------------------------------------------
# local | synthetic-staging | client-pilot | production
ACCESS_DEPLOYMENT_PROFILE=
# SYNTHETIC | REAL (REAL only in client-pilot/production, after the checklist)
ACCESS_DATA_MODE=
NODE_ENV=
BUILD_ID=
# require (mandatory outside local) and the provider's CA certificate
DATABASE_SSL=
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=
# 64 hex characters; the API and worker must hold the same key and key id
IDENTIFIER_HASH_KEY=
IDENTIFIER_HASH_KEY_ID=
# Bearer token for /metrics (required outside local)
METRICS_TOKEN=
PORT=

# --- Migration job and operator commands only (owner login) ----------------
MIGRATION_DATABASE_URL=

# --- API (Railway service "api") --------------------------------------------
# access_request login (never the owner)
API_DATABASE_URL=
# Console origin(s), comma-separated, https outside local
CONSOLE_ORIGIN=
# jwt (Supabase Auth) | synthetic (local and synthetic-staging only)
ACCESS_AUTH_MODE=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWKS_URL=
AUTH_JWT_SECRET=
ALLOW_SYNTHETIC_TENANT_CONTEXT=
# Private documents: supabase (private bucket) | local (development)
ARTIFACT_STORE=
ARTIFACT_ROOT=
ARTIFACT_RETENTION_DAYS=
# 64 hex characters; also derives the document-link signing key
ARTIFACT_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
# Server-side only (API). Never in the console, Vercel or the repository.
SUPABASE_SERVICE_ROLE_KEY=
# clamav (required with REAL data) | mock (synthetic only)
ARTIFACT_SCANNER=
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=
# Meta app: webhook signature secret and subscription verify token
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Worker (Railway service "worker") --------------------------------------
# access_worker login (never the owner)
WORKER_DATABASE_URL=
WORKER_TENANT_IDS=
WORKER_POLL_MS=
OUTBOX_MAX_ATTEMPTS=
NOTIFICATION_LEASE_SECONDS=
NOTIFICATION_BATCH_SIZE=
NOTIFICATION_CONTENT_RETENTION_DAYS=
# Synthetic environments send only to these numbers/addresses
NOTIFICATION_RECIPIENT_ALLOWLIST=
CHANNEL_SEARCH_DAYS=
CHANNEL_SEARCH_PAGES=
CHANNEL_MESSAGE_RETENTION_DAYS=
# WhatsApp Cloud API (graph.facebook.com unless overridden)
WHATSAPP_GRAPH_BASE_URL=
WHATSAPP_API_VERSION=
WHATSAPP_TIMEOUT_MS=
# One access token per WhatsApp connection, named by its secret_ref
# (must start with WHATSAPP_), e.g.:
WHATSAPP_ACCESS_TOKEN=
# E-mail notifications (optional)
SMTP_URL=
SMTP_FROM=
SMTP_REQUIRE_TLS=
SMTP_TIMEOUT_MS=
# EMR webhooks: one signing secret per connection, named by its secret_ref
# (must start with EMR_WEBHOOK_), e.g.:
EMR_WEBHOOK_SIGNING_SECRET=
INTEGRATION_TIMEOUT_MS=
INTEGRATION_ALLOW_PRIVATE_TARGETS=
INTEGRATION_PAYLOAD_RETENTION_DAYS=
# Optional intent classifier for free-text WhatsApp messages (off by default)
INTENT_CLASSIFIER=
INTENT_CLASSIFIER_MODEL=
INTENT_CLASSIFIER_TIMEOUT_MS=
INTENT_CLASSIFIER_MAX_PER_MINUTE=
INTENT_CLASSIFIER_PROCESSOR_APPROVED=
ANTHROPIC_API_KEY=
# Organisation referral pipeline (legacy destination connector)
CONNECTOR_KIND=
CONNECTOR_CAPABILITIES=
CONNECTOR_FAULT_MODE=
DISPATCH_MAX_ATTEMPTS=
DISPATCH_RETRY_SECONDS=
RECONCILE_MAX_ATTEMPTS=
RECONCILE_BASE_SECONDS=

# --- Console build (Vercel project; all public) -----------------------------
VITE_CORE_API_URL=
# supabase | synthetic (local only)
VITE_AUTH_MODE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Operator commands --------------------------------------------------------
TENANT_ID=
TENANT_NAME=
ADMIN_USER_ID=
RULES_FILE=

# --- Test suites (never in a deployment) -------------------------------------
TEST_DATABASE_URL=
REQUIRE_DATABASE_TESTS=
E2E_DATABASE_URL=
